{
	"name": "soderlind/kjeks-google",
	"description": "Google Consent Mode v2 for Kjeks: wires GA4 and Google Tag Manager to the visitor's Kjeks consent choices.",
	"type": "wordpress-plugin",
	"keywords": [
		"wordpress",
		"wordpress-plugin",
		"kjeks",
		"cookie-consent",
		"google-consent-mode",
		"consent-mode-v2",
		"ga4",
		"google-analytics",
		"gtm",
		"google-tag-manager",
		"gdpr",
		"privacy"
	],
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.3",
		"soderlind/wordpress-github-updater": "^2.0"
	},
	"require-dev": {
		"pestphp/pest": "^3.5",
		"brain/monkey": "^2.6"
	},
	"autoload": {
		"psr-4": {
			"Soderlind\\KjeksGoogle\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Soderlind\\KjeksGoogle\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "pest"
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		},
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
